# Copy to .env and fill in — NEVER commit .env
# Used by: forge script, cast, slither (root Foundry project)
# See HOW_TO.md for full setup guide

# Deployer wallet — fund with Fuji AVAX: https://faucet.avax.network
PRIVATE_KEY=your_wallet_private_key_here

# RPC endpoints (defaults work for most users)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Snowtrace API key for contract verification: https://snowtrace.io/myapikey
SNOWTRACE_API_KEY=your_snowtrace_api_key_here

# Optional — AvaCloud / ChainKit integrations (see SKILL.md)
AVACLOUD_API_KEY=your_avacloud_api_key_here

# Local Avalanche CLI network only — NEVER use on Fuji or mainnet
LOCAL_FUNDED_KEY=56289e99c94b6912bfc12adc093c9b51124f0dc54ac7a766b2bc5ccf558d8027
LOCAL_FUNDED_ADDR=0x8db97C7cEcE249c2b98bDC0226Cc4C2A57BF52FC